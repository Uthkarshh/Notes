<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="capture" android:enabled="true" android:icon="@drawable/ic_notification" android:shortcutShortLabel="@string/shortcut_capture">
        <intent android:action="com.notesapp.CAPTURE" android:targetPackage="com.notesapp" android:targetClass="com.notesapp.CaptureActivity" />
    </shortcut>
    <shortcut android:shortcutId="voice" android:enabled="true" android:icon="@drawable/ic_notification" android:shortcutShortLabel="@string/shortcut_voice">
        <intent android:action="com.notesapp.VOICE" android:targetPackage="com.notesapp" android:targetClass="com.notesapp.CaptureActivity" />
    </shortcut>
    <shortcut android:shortcutId="random" android:enabled="true" android:icon="@drawable/ic_notification" android:shortcutShortLabel="@string/shortcut_random">
        <intent android:action="com.notesapp.RANDOM" android:targetPackage="com.notesapp" android:targetClass="com.notesapp.MainActivity">
            <extra android:name="notification_type" android:value="random" />
        </intent>
    </shortcut>
</shortcuts>
